# Application Settings
PROJECT_NAME="Forex Market Analysis & Signal System"
APP_ENV=development
LOG_LEVEL=INFO

# Database Connection (SQLite default for testing / development, PostgreSQL for production)
DATABASE_URL=sqlite:///./trade.db

# Supported Instruments & Timeframes (Strict Single-Asset: US100 quarantined due to API paywall)
SUPPORTED_SYMBOLS=["XAU/USD"]
SUPPORTED_TIMEFRAMES=["15m", "1h", "4h"]

# Strategy Engine Configurations (Milestones 2-6)
SWING_LOOKBACK=2
SR_TOLERANCE_PERCENT=0.1
EMA_FAST=20
EMA_MID=50
EMA_SLOW=200
RSI_PERIOD=14
ATR_PERIOD=14

MIN_SETUP_SCORE=60.0
MIN_RR=3.0
MAX_RISK_PERCENT=5.0
# Broker lot profile: exness_standard_xauusd (default) | theoretical_fractional
BROKER_SPEC=exness_standard_xauusd

# News Filter (Milestone 5)
NEWS_PROVIDER=forexfactory
NEWS_BLACKOUT_BEFORE_MINUTES=30
NEWS_BLACKOUT_AFTER_MINUTES=15

# API Keys (Optional / Provider-specific)
MARKET_DATA_PROVIDER=twelvedata
TWELVE_DATA_API_KEY=your_twelvedata_api_key_here
ALPHA_VANTAGE_API_KEY=your_alphavantage_api_key_here
NEWS_API_KEY=your_news_api_key_here

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# Bot username used for https://t.me/<username>?start=login deep links
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=signalTheBEST_bot
# Same-origin only: Netlify proxies /api/* to Render. Never use the backend host here.
NEXT_PUBLIC_API_URL=/api/v1
# User Presentation Timezone (e.g., "Asia/Bangkok", "America/New_York", "Europe/London", "UTC")
USER_TIMEZONE=UTC

# Automated Background Scanner (Milestone 9)
SCANNER_ENABLED=true
SCANNER_INTERVAL_MINUTES=60
SCANNER_TIMEFRAMES=["1h","30m" ,"15m", "4h"]
SCANNER_AUTO_TRADE_PAPER=true
SIGNAL_COOLDOWN_HOURS=2

# Paper Trading Virtual Account Mode (Milestone 8)
PAPER_TRADING=true

# MetaTrader 5 Demo Accounts (MAIN and CENT). Required for MT5 execution.
# Windows only: the MT5 terminal must be open and the MetaTrader5 package installed.
MT5_LOGIN_MAIN=your_main_account_number
MT5_PASSWORD_MAIN=your_main_account_password
MT5_SERVER_MAIN=your_main_broker_server
MT5_LOGIN_CENT=your_cent_account_number
MT5_PASSWORD_CENT=your_cent_account_password
MT5_SERVER_CENT=your_cent_broker_server
LIVE_TRADING_ENABLED=false

# Dashboard Transport & Caching (exact origin, no wildcard with credentials)
FRONTEND_ORIGIN=https://quanview.dinacreator.space,http://localhost:3000
CORS_MAX_AGE_SECONDS=86400
DASHBOARD_POLL_SECONDS=15
DASHBOARD_CANDLE_LIMIT=60
DASHBOARD_DERIVED_LIMIT=200
DASHBOARD_NEWS_LIMIT=30
DASHBOARD_SIGNALS_LIMIT=25
DASHBOARD_TRADE_HISTORY_LIMIT=50
POSITION_MONITOR_ENABLED=true
POSITION_MONITOR_INTERVAL_SECONDS=0.5
POSITION_MONITOR_SYMBOL=XAU/USD

# Upstream provider cache + request coalescing
PROVIDER_CACHE_ENABLED=true
QUOTE_CACHE_TTL_SECONDS=5
QUOTE_RESPONSE_CACHE_TTL_SECONDS=60
DERIVED_CACHE_TTL_SECONDS=30
STALE_ON_THROTTLE=true
LATENCY_SAMPLE_SIZE=200

# Telegram Authentication & Multi-User Broadcast (Milestone 2)
AUTH_ENABLED=true
# Temporary: log Telegram widget data-check-string + computed hash on failure
AUTH_DEBUG=false
JWT_SECRET_KEY=replace-with-a-long-random-secret
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_NAME=quantview_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
LOGIN_LINK_TTL_SECONDS=300
MAGIC_LINK_BASE_URL=https://quanview.dinacreator.space
ADMIN_TELEGRAM_ID=
TELEGRAM_BROADCAST_DELAY_SECONDS=0.5
WIDGET_AUTH_MAX_AGE_SECONDS=3600
WIDGET_SESSION_TTL_SECONDS=2592000
WIDGET_COOKIE_SECURE=true
WIDGET_COOKIE_SAMESITE=lax
DASHBOARD_REDIRECT_URL=https://quanview.dinacreator.space/dashboard
